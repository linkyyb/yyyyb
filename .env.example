# DeepSeek API Key — Required for all AI features (chat, document parsing, vocabulary extraction)
# Get your API key from: https://platform.deepseek.com/api_keys
# The app stores this key in your browser's localStorage and sends it to the server for API requests.
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Optional: Override the default model
# Supported values: deepseek-v4-pro (default), deepseek-v4-flash
DEEPSEEK_MODEL="deepseek-v4-pro"

# Optional: Server port (default: 3000)
PORT=3000
